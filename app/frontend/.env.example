# Local development settings for the frontend.
#
# Copy the lines you need into .env.development.local (git-ignored, loaded by `npm run dev` only).
# Don't use .env.local or .env.production: those are also read by `npm run build`.
#
# There is no backend URL to configure for production: after sign-in the account picks the backend
#   Google sign-in   -> https://finance-backend-328452160072.asia-northeast1.run.app      (personal)
#   email/password   -> https://finance-backend-demo-328452160072.asia-northeast3.run.app (demo)
# The Firebase web config is public and lives in src/config/firebase.ts.

# --- VITE_API_BASE_URL (dev server only; ignored by production builds) ---
# Sends every account's requests to one backend instead of routing by sign-in method.
#   A local backend (its CORS must allow http://localhost:5173):
#     VITE_API_BASE_URL=http://127.0.0.1:8081
#   Same-origin through the Vite proxy (Cloud Shell web preview): set it to an empty value
#     VITE_API_BASE_URL=
#   and point the proxy at the backend with BACKEND_URL below.
# VITE_API_BASE_URL=

# --- BACKEND_URL (read by vite.config.ts, never sent to the browser) ---
# Proxy target for same-origin mode. Default: http://127.0.0.1:8080 (or BACKEND_PORT).
# BACKEND_URL=http://127.0.0.1:8080
