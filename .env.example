# Backend settings for local development.
#
# Copy this file to .env in the repository root (git-ignored) and uncomment what you need.
# app/config.py reads it at startup; variables already set in your shell take precedence.
# Keep comments on their own lines: the loader does not strip inline "# ..." comments.
#
# Secrets: leave DB_PASS / GMAIL_APP_PASSWORD / GMAIL_PDF_PASSWORD unset to read them from
# Google Secret Manager with your gcloud login (store one with: scripts/set_secret.sh <name>).

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# personal | demo (selects the database, sign-in allowlist and AI limits)
# APP_ENV=personal

# ---------------------------------------------------------------------------
# Google Cloud / Vertex AI
# ---------------------------------------------------------------------------
# PROJECT_ID=your-gcp-project-id
# Gemini 3 models are served from the global endpoint.
# LOCATION=global
# Standard tier: statements, receipts, spreadsheets, insight reports, AI CFO chat.
# MODEL_NAME=gemini-3.5-flash
# Quick look-ups and voice clarifications.
# MODEL_LITE=gemini-3.5-flash-lite
# Planning questions (retirement, portfolio, tax).
# MODEL_PRO=gemini-3.5-flash
# 1 stores the advisor's static persona in an explicit Vertex AI cache per model and passes it to
# Gemini as cached_content. If a cache can't be created (gemini-3.5-flash needs at least 4,096
# tokens; the persona is about 170), requests are sent as usual. Token usage, including tokens
# served from implicit caching, is recorded either way.
# ENABLE_VERTEX_CONTEXT_CACHE=0

# ---------------------------------------------------------------------------
# Google Cloud governance and tracing (all off by default)
# ---------------------------------------------------------------------------
# Model Armor API. A full template name turns it on for chat prompts, document text and the
# advisor's replies, after the local regex screen (which stays the fallback if the API fails).
# The template's regional endpoint is used: modelarmor.<location>.rep.googleapis.com.
# MODEL_ARMOR_TEMPLATE=projects/your-gcp-project-id/locations/asia-northeast1/templates/pfa-guard
# Seconds to wait for Model Armor before keeping the regex result.
# MODEL_ARMOR_TIMEOUT_SECONDS=5
# 1 adds Sensitive Data Protection (Cloud DLP API) findings to the regex PII redaction.
# SDP_ENABLED=0
# Built-in infoTypes, comma-separated. Confirm the names with infoTypes.list once the API is on.
# SDP_INFO_TYPES=INDIA_PAN_INDIVIDUAL,INDIA_AADHAAR_INDIVIDUAL,EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD_NUMBER
# One of VERY_UNLIKELY, UNLIKELY, POSSIBLE, LIKELY, VERY_LIKELY.
# SDP_MIN_LIKELIHOOD=LIKELY
# SDP_LOCATION=global
# SDP_TIMEOUT_SECONDS=10
# 1 also exports OpenTelemetry spans to Cloud Trace in PROJECT_ID.
# ENABLE_CLOUD_TRACE=0

# ---------------------------------------------------------------------------
# Database (Supabase connection pooler by default)
# ---------------------------------------------------------------------------
# DB_USER=postgres
# DB_NAME=postgres
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_POOLER_HOST=aws-0-your-region.pooler.supabase.com
# SUPABASE_POOLER_PORT=6543
# Secret Manager secret holding the password (read when DB_PASS is unset).
# DB_PASSWORD_SECRET=pfa-db-password-personal
# Secret. Prefer Secret Manager.
# DB_PASS=
# Optional full connection URL, e.g. a local Postgres (overrides the pooler settings).
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
# Legacy Cloud SQL connector (project:region:instance).
# INSTANCE_CONNECTION_NAME=

# ---------------------------------------------------------------------------
# Sign-in, scheduler and CORS
# ---------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Comma-separated "email" or "email:provider" entries (provider: google.com or password).
# AUTH_ALLOWED_USERS=you@example.com:google.com
# Service account and audience expected on Cloud Scheduler OIDC tokens for /internal/*.
# SCHEDULER_SA_EMAIL=pfa-scheduler@your-gcp-project-id.iam.gserviceaccount.com
# An empty audience rejects every /internal/* call.
# INTERNAL_AUDIENCE=
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Features and limits
# ---------------------------------------------------------------------------
# Per-feature daily AI caps (India time). Demo default: chat=40,insights=10,upload=10,voice=40,eval=3
# AI_DAILY_LIMITS=
# Private Cloud Storage bucket for statement PDFs; empty stores them on local disk.
# STATEMENT_BUCKET=
# Statement reading: pages per Gemini call and calls in parallel.
# STATEMENT_PAGES_PER_CALL=2
# STATEMENT_PARALLEL_CALLS=6
# 1 exposes /docs, /redoc and /openapi.json.
# ENABLE_API_DOCS=0
# 1 runs the hourly Gmail check in-process (Cloud Scheduler is the default).
# ENABLE_GMAIL_BACKGROUND_WORKER=0

# ---------------------------------------------------------------------------
# Gmail Bank Sync (personal environment only)
# ---------------------------------------------------------------------------
# GMAIL_EMAIL=you@gmail.com
# GMAIL_APP_PASSWORD_SECRET=pfa-gmail-app-password
# STATEMENT_PASSWORDS_SECRET=pfa-statement-passwords
# Secrets. Prefer Secret Manager.
# GMAIL_APP_PASSWORD=
# GMAIL_PDF_PASSWORD=

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------
# Secret. Unset: every process signs workload tokens with its own random key.
# AGENT_WIF_SIGNING_KEY=
# GCP_PROJECT_NUMBER=
# GCP_AGENT_REGISTRY_LOCATION=global
# CLOUD_RUN_BASE_URL=https://your-backend.run.app

# ---------------------------------------------------------------------------
# Owner profile (owner-only data; see app/owner_profile.py)
# ---------------------------------------------------------------------------
# Default: app/private/owner_profile.json (git-ignored). Use an absolute path if you override it.
# OWNER_PROFILE_PATH=/absolute/path/to/owner_profile.json

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Enables tests/test_reconcile_db.py against a throwaway local Postgres (host must be local).
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55433/postgres
# Enables tests/test_fde_integration.py, which calls the REAL personal database and Gemini.
# PFA_LIVE_TESTS=1
